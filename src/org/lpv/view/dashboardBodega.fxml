<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.lpv.controller.DashboardBodegaController"
      alignment="CENTER"
      spacing="20"
      prefWidth="800"
      prefHeight="500">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Dashboard Bodega"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label fx:id="lblUsuario"
           text="Usuario"/>

    <Label text="Gestión de catálogo e inventario"/>

    <Button text="Gestionar libros"
            prefWidth="200"
            onAction="#abrirGestionLibros"/>

    <Button text="Cambiar contraseña"
            prefWidth="200"
            onAction="#abrirCambioContrasena"/>

    <Button text="Cerrar sesión"
            prefWidth="200"
            onAction="#cerrarSesion"/>

</VBox>