<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.lpv.controller.DashboardGestionLibrosController"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="25" bottom="10" left="25"/>
            </padding>

            <Label text="Gestión de libros"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label text="Registro y administración del catálogo"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>

            <!-- FORMULARIO -->

            <GridPane hgap="10" vgap="10">

                <Label text="ISBN:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtIsbn"
                           promptText="ISBN del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Título:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtTitulo"
                           promptText="Título del libro"
                           prefWidth="250"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Fecha publicación:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="dpFechaPublicacion"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                <Label text="Precio:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtPrecio"
                           promptText="0.00"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="ID categoría:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtIdCategoria"
                           promptText="ID categoría"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="NIT editorial:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtNitEditorial"
                           promptText="NIT editorial"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="2"/>

                <Label text="Stock actual:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtStockActual"
                           promptText="0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Stock mínimo:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtStockMinimo"
                           promptText="0"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="3"/>

            </GridPane>

            <!-- BOTONES -->

            <HBox spacing="10">

                <Button text="Registrar"
                        onAction="#registrarLibro"/>

                <Button text="Actualizar"
                        onAction="#actualizarLibro"/>

                <Button text="Activar / Desactivar"
                        onAction="#cambiarEstadoLibro"/>

                <Button text="Limpiar"
                        onAction="#limpiarFormulario"/>

            </HBox>

            <!-- TABLA -->

            <TableView fx:id="tablaLibros"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colIsbn"
                                 text="ISBN"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colTitulo"
                                 text="Título"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colStockMinimo"
                                 text="Mínimo"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="70"/>

                </columns>

            </TableView>

            <!-- REGRESAR -->

            <HBox spacing="10">

                <Button text="Regresar"
                        onAction="#regresar"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>