<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.lpv.controller.DashboardUsuarioController"
      alignment="CENTER"
      spacing="15"
      prefWidth="900"
      prefHeight="600">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="Gestión de Usuarios"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaUsuarios"
               prefWidth="840"
               prefHeight="300">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="80"/>

            <TableColumn fx:id="colUsername"
                         text="Usuario"
                         prefWidth="250"/>

            <TableColumn fx:id="colRol"
                         text="Rol"
                         prefWidth="200"/>

            <TableColumn fx:id="colActivo"
                         text="Activo"
                         prefWidth="150"/>

        </columns>

    </TableView>

    <Label text="Datos del usuario"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="15"
          alignment="CENTER">

        <VBox spacing="5">

            <Label text="Usuario"/>

            <TextField fx:id="txtUsername"
                       promptText="Nombre de usuario"
                       prefWidth="200"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Contraseña"/>

            <PasswordField fx:id="txtPassword"
                           promptText="Contraseña"
                           prefWidth="200"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Rol"/>

            <ComboBox fx:id="cmbRol"
                      promptText="Seleccione un rol"
                      prefWidth="160"/>

        </VBox>

    </HBox>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"/>

    <HBox spacing="10"
          alignment="CENTER">

        <Button text="Crear"
                onAction="#crearUsuario"
                prefWidth="110"/>

        <Button text="Actualizar"
                onAction="#actualizarUsuario"
                prefWidth="110"/>

        <Button text="Activar / Desactivar"
                onAction="#cambiarEstado"
                prefWidth="150"/>

        <Button text="Limpiar"
                onAction="#limpiar"
                prefWidth="110"/>

        <Button text="Regresar"
                onAction="#regresar"
                prefWidth="110"/>

    </HBox>

</VBox>